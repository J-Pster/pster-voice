# ElevenLabs API key (Scribe v2 speech-to-text). Get yours at elevenlabs.io -> profile -> API Keys,
# with write permission on "Speech to Text".
ELEVENLABS_API_KEY=your_api_key_here

# Gemini API key (text cleanup pass after transcription). Get yours at aistudio.google.com/apikey.
GEMINI_API_KEY=your_gemini_api_key_here
